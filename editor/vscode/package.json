{
  "name": "c-prime-syntax",
  "displayName": "C-Prime",
  "description": "Syntax highlighting for the C-Prime (.cp) systems programming language",
  "version": "0.1.0",
  "publisher": "zabyt",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cprime",
        "aliases": [
          "C-Prime",
          "cprime",
          "cp"
        ],
        "extensions": [
          ".cp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cprime",
        "scopeName": "source.cprime",
        "path": "./syntaxes/cp.tmLanguage.json"
      }
    ]
  }
}